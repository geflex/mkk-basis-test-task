# Static API key required in the X-API-Key header (no default; must be set)
API_KEY=change-me-in-production

# Async SQLAlchemy URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments

# RabbitMQ connection URL
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Broker topology
PAYMENTS_EXCHANGE=payments
PAYMENTS_NEW_QUEUE=payments.new
PAYMENTS_DLQ_QUEUE=payments.dlq
RETRY_ROUTING_PREFIX=payments.retry
BASE_RETRY_DELAY_MS=2000

# Outbox relay
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_BATCH_SIZE=100

# Processing emulation
MAX_ATTEMPTS=3
PROCESSING_MIN_SECONDS=2
PROCESSING_MAX_SECONDS=5
SUCCESS_RATE=0.9

# Webhooks
WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=1
# Optional shared secret; when set, notifications carry X-Webhook-Signature
WEBHOOK_SECRET=
# Set to true only for local testing against a host on the same machine/LAN
ALLOW_PRIVATE_WEBHOOK_HOSTS=false
