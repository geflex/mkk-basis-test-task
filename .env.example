# Статический API-ключ, обязательный в заголовке X-API-Key (значения по умолчанию нет; должен быть задан)
API_KEY=change-me-in-production

# URL асинхронного SQLAlchemy (драйвер asyncpg)
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=1800
DATABASE_COMMAND_TIMEOUT=30

# URL подключения к RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Топология брокера
PAYMENTS_EXCHANGE=payments
PAYMENTS_NEW_QUEUE=payments.new
PAYMENTS_DLQ_QUEUE=payments.dlq
RETRY_ROUTING_PREFIX=payments.retry
BASE_RETRY_DELAY_MS=2000

# Relay outbox
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_BATCH_SIZE=100

# Эмуляция обработки
MAX_ATTEMPTS=3
PROCESSING_MIN_SECONDS=2
PROCESSING_MAX_SECONDS=5
SUCCESS_RATE=0.9

# Webhook'и
WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=1
WEBHOOK_MAX_RESPONSE_BYTES=1048576
# Необязательный общий секрет; если задан, уведомления несут X-Webhook-Signature
WEBHOOK_SECRET=
# Ставьте true только для локального тестирования против хоста на той же машине/в локальной сети
ALLOW_PRIVATE_WEBHOOK_HOSTS=false

# Логирование: LOG_JSON=true удобно для сборщиков логов
LOG_LEVEL=INFO
LOG_JSON=false